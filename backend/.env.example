PORT=8080
GOOGLE_PLAY_PACKAGE_NAME=com.linkqr
GOOGLE_PLAY_PRO_PRODUCT_ID=linkqr_pro
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
DATABASE_PATH=./linkqr-billing.db
# Optional. Enables automated online SQLite backups when set.
DATABASE_BACKUP_DIR=
DATABASE_BACKUP_INTERVAL_HOURS=24

# User authentication is disabled by default.
LINKQR_AUTH_ENABLED=false
LINKQR_AUTH_SESSION_DAYS=30
# Required when authentication is enabled.
LINKQR_AUTH_EMAIL_WEBHOOK_URL=
LINKQR_AUTH_EMAIL_WEBHOOK_TOKEN=
LINKQR_AUTH_EMAIL_VERIFICATION_HOURS=24
LINKQR_AUTH_PASSWORD_RESET_MINUTES=30

# SaaS sync is disabled by default.
# Production API keys must be at least 32 characters and stay server-side.
LINKQR_SAAS_ENABLED=false
LINKQR_SAAS_API_KEY=
LINKQR_SAAS_FREE_QR_LIMIT=100
LINKQR_SAAS_PRO_QR_LIMIT=10000

# API protection defaults: 300 requests/minute and 120 writes/minute per principal+route.
LINKQR_API_RATE_LIMIT_PER_MINUTE=300
LINKQR_API_WRITE_RATE_LIMIT_PER_MINUTE=120
LINKQR_API_IDEMPOTENCY_TTL_HOURS=24

# Optional. Enables protected Prometheus-compatible /metrics endpoint.
# Keep this server-side and use a 32+ character random secret.
LINKQR_OBSERVABILITY_TOKEN=
