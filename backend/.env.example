PORT=8080
GOOGLE_PLAY_PACKAGE_NAME=com.linkqr
GOOGLE_PLAY_PRO_PRODUCT_ID=linkqr_pro
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
DATABASE_PATH=./linkqr-billing.db

# User authentication is disabled by default.
LINKQR_AUTH_ENABLED=false
LINKQR_AUTH_SESSION_DAYS=30

# SaaS sync is disabled by default.
# Production API keys must be at least 32 characters and stay server-side.
LINKQR_SAAS_ENABLED=false
LINKQR_SAAS_API_KEY=
LINKQR_SAAS_FREE_QR_LIMIT=100
LINKQR_SAAS_PRO_QR_LIMIT=10000
